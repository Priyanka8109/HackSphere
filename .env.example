# ==================================================
# HackSphere Environment Variables Template (Experiment 7)
# Copy this file to .env and configure your variables
# ==================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment (production / development)
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# --------------------------------------------------
# MongoDB Connection URI Options:
# --------------------------------------------------
# Option 1: Local direct host execution (npm run dev / verify scripts):
MONGO_URI=mongodb://127.0.0.1:27017/HackSphereDB

# Option 2: Docker container accessing host MongoDB:
DOCKER_MONGO_URI=mongodb://host.docker.internal:27017/HackSphereDB

# Option 3: MongoDB Atlas (Cloud Database for both host & Docker):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/HackSphereDB?retryWrites=true&w=majority
# DOCKER_MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/HackSphereDB?retryWrites=true&w=majority

# Frontend API URL (leave blank for relative Nginx proxy in Docker/Vite)
VITE_API_BASE_URL=
